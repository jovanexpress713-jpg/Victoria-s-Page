{
  "name": "victoria-line-soft",
  "private": true,
  "version": "3.2.0",
  "type": "module",
  "description": "الموقع الرسمي لاستوديو Victoria Line Soft — React 19 + TypeScript + Vite + Tailwind CSS v4 (عربي RTL)",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && vite build && node scripts/generate-sitemap.mjs",
    "assets": "node scripts/generate-brand-assets.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "serve": "npm run build && npm run preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "framer-motion": "^14.6.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.0.9",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^15.15.0",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.2.0",
    "vitest": "^3.2.7"
  }
}
