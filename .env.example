# ============================================================
# متغيرات البيئة — Victoria Line Soft (كلها اختيارية وللواجهة فقط)
# انسخ الملف إلى .env وعدّل القيم، ثم أعد البناء.
# ملاحظة: أي متغير يصل للمتصفح يجب أن يبدأ بـ VITE_ وهو عام بطبيعته،
# لذلك لا تضع هنا أسراراً حقيقية (مفاتيح APIs أو كلمات مرور نصية).
# ============================================================

# رقم واتساب الرسمي بصيغة دولية بدون + (افتراضياً: 967771119726)
VITE_WHATSAPP_NUMBER=967771119726

# اسم الموقع الظاهر في العناوين ووسوم المشاركة
VITE_APP_NAME=Victoria Line Soft

# النطاق الكامل للموقع (يُستخدم في canonical وsitemap ووسوم المشاركة)
# مثال: https://victorialinesoft.com
VITE_SITE_URL=

# بصمة SHA-256 (hex) لكلمة مرور لوحة الإدارة.
# توليدها:  node -e "crypto.subtle.digest('SHA-256',new TextEncoder().encode('كلمة-المرور')).then(b=>console.log([...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,'0')).join('')))"
# أو:       openssl dgst -sha256 <<< 'كلمة-المرور'  (خذ الجزء hex فقط)
# بدونها: يعمل الدخول التجريبي في التطوير فقط، وتُقفَل لوحة التحكم في الإنتاج.
VITE_ADMIN_PASSWORD_HASH=

# مدة جلسة الإدارة بالدقائق (افتراضياً 120)
VITE_ADMIN_SESSION_MINUTES=120
